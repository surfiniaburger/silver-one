GOOGLE_GENAI_USE_VERTEXAI=FALSE
GOOGLE_API_KEY=

# Sampling controls are recorded in RunRecord, attempt logs, corpus metadata,
# and B-gate metrics. Leave the profile enabled when using Gemma 4 models.
LLM_SAMPLING_PROFILE=ollama_gemma4
# Optional global overrides. If set, these apply to all tracked LiteLLM calls
# unless a model-specific profile overrides them.
# LLM_TEMPERATURE=1.0
# LLM_TOP_P=0.95
# LLM_TOP_K=64
# LLM_MAX_TOKENS=
